# Mapping study area on R

###Map USA zoom WA
setwd('~/Map and plots WA')

USA <- ne_countries(country="United States of America", returnclass = "sf", scale="large")
plot<-ggplot(data = USA) +geom_sf(fill="grey80",color="grey30") + coord_sf(xlim = c(-62, -130), ylim = c(22,50),expand = TRUE)+
  theme(panel.background = element_rect(fill = "grey80"))+
  theme(panel.grid.major = element_line(colour = "transparent"))
plot
plot+geom_rect(aes(xmin=-123.24, xmax=-121.78, ymin=46.88, ymax=49), 
               color="red",fill="transparent") 

ggsave('USA-rect-WA.tiff', dpi = 600, height = 5, width = 10, unit = 'cm')


###Map Bay WA

setwd('~/Map and plots WA')

sampling_points <- read.csv("coordinates.csv", header = TRUE)
sampling_points_sf <- st_as_sf(sampling_points, coords = c("Longitude", "Latitude"), crs = 4326, remove = FALSE)

hatchery <- c("Point Whitney hatchery","Taylor Shellfish hatchery","Lummi Shellfish hatchery")
hatchery_points <- sampling_points_sf[sampling_points_sf$Location %in% hatchery,]
other_points <- sampling_points_sf[!(sampling_points_sf$Location %in% hatchery),]

worldMap <- ne_countries(scale = 10, returnclass = "sf")

plot<-ggplot(data = worldMap) +geom_sf(color = "grey30", fill = "grey80") + coord_sf(xlim = c(-121.78,-123.5), ylim = c(46.88,49.1),expand = FALSE)+xlab("Longitude") +ylab("Latitude") +
  theme(panel.grid.major = element_line( size = 0.1)) +
  annotation_scale(location = "bl", width_hint = 0.25,pad_x = unit(0.10, "cm"),pad_y = unit(0.2, "cm")) +
  geom_point(data = hatchery_points, aes(x = Longitude, y = Latitude),shape=22, color='black', fill="black", stroke=0.5, size=3)+
  geom_point(data = other_points, aes(x = Longitude, y = Latitude),shape=21, color='black', fill="red4", stroke=0.5, size=3) +
  annotation_north_arrow(location = "br",height=unit(1,"cm"),width=unit(0.5,"cm"),pad_x = unit(0.25, "cm")) +
  theme(panel.grid.major = element_blank())

plot+theme(panel.grid.major = element_line(color = "white", linetype ="dashed", linewidth = 0.1),
      panel.ontop = TRUE,
      panel.background = element_rect(fill = NA, color = NA))

ggsave('WA.tiff', dpi = 600, height = 30, width = 10, unit = 'cm')


